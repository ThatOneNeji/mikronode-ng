{
    "tags": {
        "allowUnknownTags": true
    },
    "source": {
        "includePattern": ".+\\.js(doc|x)?$",
        "exclude": ["node_modules", "lib/node_modules"],
        "excludePatterns": "(^|\\/|\\\\|node_modules)"
    },
    "plugins": ["plugins/markdown"],
    "templates": {
        "cleverLinks": false,
        "systemName": "netstats - MySQL Loader",
        "monospaceLinks": false,
        "dateFormat": "YYYY/MM/DD",
        "navType": "inline",
        "theme": "slate",
        "linenums": true,
        "footer": "",
        "inverseNav": false,
        "default": {
            "outputSourceFiles": true
        }
    },
    "opts": {
        "encoding": "utf8",
        "destination": "./doc/",
        "recurse": true
    }
}
